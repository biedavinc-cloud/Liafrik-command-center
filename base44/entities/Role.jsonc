{
  "name": "Role",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "rank": {
      "type": "number"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_system": {
      "type": "boolean",
      "default": false
    },
    "locked": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "key",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}