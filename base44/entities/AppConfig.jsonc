{
  "name": "AppConfig",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string"
    },
    "application_name": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "staging",
        "production"
      ],
      "default": "production"
    },
    "section": {
      "type": "string",
      "enum": [
        "feature_flag",
        "setting",
        "integration",
        "security",
        "limits",
        "maintenance"
      ],
      "default": "setting"
    },
    "key": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "value_type": {
      "type": "string",
      "enum": [
        "string",
        "boolean",
        "number",
        "json",
        "secret"
      ],
      "default": "string"
    },
    "is_secret": {
      "type": "boolean",
      "default": false
    },
    "is_configured": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string"
    },
    "last_changed_by": {
      "type": "string"
    },
    "last_changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "application_id",
    "key",
    "section"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}