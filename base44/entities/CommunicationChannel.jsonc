{
  "name": "CommunicationChannel",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "description": "Channel key (resend, smtp, telegram, whatsapp, twilio)"
    },
    "display_name": {
      "type": "string"
    },
    "credentials": {
      "type": "object",
      "description": "Actual credential values (API keys, tokens) \u2014 server-side only"
    },
    "credential_hints": {
      "type": "object",
      "description": "Masked hints for display in the UI"
    },
    "configured": {
      "type": "boolean",
      "default": false
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "last_tested": {
      "type": "string",
      "format": "date-time"
    },
    "last_test_result": {
      "type": "string"
    },
    "configured_by": {
      "type": "string"
    },
    "configured_by_email": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    }
  },
  "required": [
    "channel",
    "display_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}