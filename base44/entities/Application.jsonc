{
  "name": "Application",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "saas",
        "marketplace",
        "crm",
        "ecommerce",
        "internal_tool",
        "customer_portal",
        "financial_platform",
        "other"
      ],
      "default": "saas"
    },
    "domain": {
      "type": "string"
    },
    "admin_url": {
      "type": "string"
    },
    "api_url": {
      "type": "string"
    },
    "health_endpoint": {
      "type": "string",
      "default": "/health"
    },
    "auth_method": {
      "type": "string",
      "enum": [
        "api_key",
        "oauth2",
        "jwt",
        "sso"
      ],
      "default": "api_key"
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "staging",
        "production"
      ],
      "default": "production"
    },
    "api_version": {
      "type": "string",
      "default": "v1"
    },
    "version": {
      "type": "string"
    },
    "connector_version": {
      "type": "string",
      "default": "1.0.0"
    },
    "protocol_version": {
      "type": "string",
      "default": "v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "degraded",
        "warning",
        "offline",
        "unknown"
      ],
      "default": "unknown"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "archived"
      ],
      "default": "active"
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "connected",
        "connecting",
        "not_connected",
        "configured",
        "pending",
        "degraded",
        "error",
        "disabled",
        "archived"
      ],
      "default": "pending"
    },
    "compatibility_status": {
      "type": "string",
      "enum": [
        "compatible",
        "incompatible",
        "unknown"
      ],
      "default": "unknown"
    },
    "maintenance_mode": {
      "type": "string",
      "enum": [
        "normal",
        "maintenance",
        "read_only",
        "disabled"
      ],
      "default": "normal"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "icon_color": {
      "type": "string"
    },
    "users_count": {
      "type": "number",
      "default": 0
    },
    "transactions": {
      "type": "number",
      "default": 0
    },
    "revenue": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "AED"
    },
    "payment_provider": {
      "type": "string"
    },
    "uptime": {
      "type": "number"
    },
    "response_ms": {
      "type": "number"
    },
    "error_rate": {
      "type": "number"
    },
    "request_count": {
      "type": "number"
    },
    "last_heartbeat": {
      "type": "string",
      "format": "date-time"
    },
    "last_deployment": {
      "type": "string",
      "format": "date-time"
    },
    "last_successful_connection": {
      "type": "string",
      "format": "date-time"
    },
    "last_failed_connection": {
      "type": "string",
      "format": "date-time"
    },
    "last_failed_reason": {
      "type": "string"
    },
    "heartbeat_interval_sec": {
      "type": "number",
      "default": 60
    },
    "sso_enabled": {
      "type": "boolean",
      "default": false
    },
    "client_id": {
      "type": "string"
    },
    "credential_hint": {
      "type": "string"
    },
    "registration_token_hint": {
      "type": "string"
    },
    "registration_status": {
      "type": "string",
      "enum": [
        "active",
        "used",
        "expired",
        "revoked"
      ],
      "default": "active"
    },
    "allowed_origins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ip_restrictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rate_limit": {
      "type": "number",
      "default": 1000
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "lock_reason": {
      "type": "string"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "locked_by": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "repo_url": {
      "type": "string"
    },
    "repo_branch": {
      "type": "string"
    },
    "last_commit": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "slug",
    "type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}