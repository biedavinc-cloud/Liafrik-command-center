{
  "name": "ApplicationEnvironment",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "url": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "degraded",
        "warning",
        "offline",
        "unknown"
      ],
      "default": "unknown"
    },
    "api_status": {
      "type": "string",
      "enum": [
        "connected",
        "not_connected",
        "configured",
        "pending",
        "error"
      ],
      "default": "pending"
    },
    "health": {
      "type": "number"
    },
    "last_deployment": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "application_id",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}