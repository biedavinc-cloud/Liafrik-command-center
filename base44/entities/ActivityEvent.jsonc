{
  "name": "ActivityEvent",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string"
    },
    "application_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "description": "Formal event type from the event catalog (e.g. application.connected)"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "info"
    },
    "correlation_id": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "application_id",
    "message"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}