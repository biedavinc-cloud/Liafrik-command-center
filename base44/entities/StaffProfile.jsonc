{
  "name": "StaffProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 User ID this profile extends"
    },
    "photo_url": {
      "type": "string",
      "description": "Public URL of the profile photo"
    },
    "job_title": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "default": "Asia/Dubai"
    },
    "notification_prefs": {
      "type": "object",
      "description": "Per-user notification preferences (email, in_app, etc.)"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}