{
  "name": "CurrencyRate",
  "type": "object",
  "properties": {
    "base_currency": {
      "type": "string",
      "description": "ISO 4217 base currency code (e.g. USD)"
    },
    "rates": {
      "type": "object",
      "description": "Map of currency codes to exchange rates relative to base_currency"
    },
    "provider": {
      "type": "string",
      "description": "Exchange rate provider used (e.g. open-er-api)"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "base_currency",
    "rates"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}