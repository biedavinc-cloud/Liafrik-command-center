{
  "name": "WebhookConfig",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string"
    },
    "application_name": {
      "type": "string"
    },
    "event": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "error"
      ],
      "default": "active"
    },
    "secret_hint": {
      "type": "string"
    },
    "last_delivery": {
      "type": "string",
      "format": "date-time"
    },
    "last_status": {
      "type": "number"
    },
    "success_count": {
      "type": "number",
      "default": 0
    },
    "failure_count": {
      "type": "number",
      "default": 0
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "http_status": {
            "type": "number"
          },
          "response_time_ms": {
            "type": "number"
          },
          "attempt": {
            "type": "number"
          },
          "result": {
            "type": "string",
            "enum": [
              "success",
              "failure"
            ]
          },
          "correlation_id": {
            "type": "string"
          }
        }
      }
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "application_id",
    "event",
    "endpoint"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}