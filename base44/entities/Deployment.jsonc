{
  "name": "Deployment",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "version": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "deployed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "building",
        "deploying",
        "successful",
        "failed",
        "cancelled"
      ]
    },
    "duration_sec": {
      "type": "number"
    },
    "source": {
      "type": "string",
      "default": "manual"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "application_id",
    "environment",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}