{
  "name": "AutomationRule",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "trigger_event": {
      "type": "string",
      "description": "Event type that fires this rule (e.g. application.health_changed)"
    },
    "trigger_condition": {
      "type": "string",
      "description": "JSON string of filter conditions"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "create_incident",
        "send_notification",
        "disable_application",
        "enable_maintenance",
        "call_webhook",
        "rotate_key",
        "lock_application"
      ],
      "default": "send_notification"
    },
    "action_config": {
      "type": "string",
      "description": "JSON string of action parameters"
    },
    "application_scope": {
      "type": "string",
      "description": "Application ID or 'all'"
    },
    "environment_scope": {
      "type": "string",
      "enum": [
        "development",
        "staging",
        "production",
        "all"
      ],
      "default": "all"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "last_fired": {
      "type": "string",
      "format": "date-time"
    },
    "fire_count": {
      "type": "number",
      "default": 0
    },
    "created_by": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "trigger_event",
    "action_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}