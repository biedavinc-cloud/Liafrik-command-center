{
  "name": "NotificationRule",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "trigger": {
      "type": "string"
    },
    "conditions": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "application_scope": {
      "type": "string"
    },
    "environment_scope": {
      "type": "string"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "in_app",
          "email",
          "webhook"
        ]
      }
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "last_fired": {
      "type": "string",
      "format": "date-time"
    },
    "fire_count": {
      "type": "number",
      "default": 0
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "trigger",
    "action"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}