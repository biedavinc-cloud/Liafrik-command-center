{
  "name": "Invitation",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "global_role": {
      "type": "string",
      "enum": [
        "superadmin",
        "global_admin",
        "platform_admin",
        "manager",
        "support",
        "analyst",
        "viewer",
        "none"
      ],
      "default": "none"
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "token": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "used",
        "expired",
        "revoked"
      ],
      "default": "pending"
    },
    "invited_by": {
      "type": "string"
    },
    "invited_by_email": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "used_at": {
      "type": "string",
      "format": "date-time"
    },
    "used_by_email": {
      "type": "string"
    },
    "administrator_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    }
  },
  "required": [
    "email",
    "token"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}