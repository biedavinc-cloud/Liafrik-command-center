{
  "name": "Branding",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Singleton key, always 'global'",
      "default": "global"
    },
    "organization_name": {
      "type": "string"
    },
    "organization_description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string",
      "description": "Public URL of the light logo variant"
    },
    "logo_dark_url": {
      "type": "string",
      "description": "Public URL of the dark logo variant"
    },
    "favicon_url": {
      "type": "string"
    },
    "primary_color": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}